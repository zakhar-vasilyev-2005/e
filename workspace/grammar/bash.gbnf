root ::= script
script ::= blank* list? blank*
blank ::= line-end
line-end ::= sp comment? nl
sp ::= [ \t]*
sp1 ::= [ \t]+
nl ::= "\n" | "\r\n"
comment ::= "#" [^\n]*
list ::= and-or-list (list-sep and-or-list)* list-sep?
list-sep ::= line-end+ | sp (";" | "&") sp comment? nl?
and-or-list ::= pipeline (and-or-op pipeline)*
and-or-op ::= sp ("&&" | "||") line-end* sp
pipeline ::= sp time? bang? pipe-seq sp
time ::= "time" sp1
bang ::= "!" sp1?
pipe-seq ::= command (sp pipe-op line-end* sp command)*
pipe-op ::= "|" | "|&"
command ::= compound-command redir-seq? | function-def redir-seq? | coproc-command redir-seq? | simple-command
redir-seq ::= redirection (sp? redirection)*
simple-command ::= simple-item (sp1 simple-item)*
simple-item ::= redirection | array-assignment | comment | word
function-def ::= "function" sp1 word sp? "(" ")" line-end* command | "function" sp1 word line-end* command | word sp? "(" ")" line-end* command
coproc-command ::= "coproc" sp1 command
compound-command ::= brace-group | subshell | arith-command | test-command | if-command | while-command | until-command | for-command | select-command | case-command
brace-group ::= "{" line-end* list? line-end* "}"
subshell ::= "(" line-end* list? line-end* ")"
arith-command ::= "((" line-end* arith-body line-end* "))"
arith-body ::= ([^()] | "(" arith-body ")")*
test-command ::= "[[" line-end* test-body line-end* "]]"
test-body ::= ([^]] | "]" [^]])*
if-command ::= "if" line-end* list? line-end* "then" line-end* list? line-end* elif-clause* else-clause? "fi"
elif-clause ::= "elif" line-end* list? line-end* "then" line-end* list? line-end*
else-clause ::= "else" line-end* list? line-end*
while-command ::= "while" line-end* list? line-end* "do" line-end* list? line-end* "done"
until-command ::= "until" line-end* list? line-end* "do" line-end* list? line-end* "done"
for-command ::= "for" sp1 word line-end* for-rest
for-rest ::= for-in-rest | for-arith-rest | do-block
for-in-rest ::= "in" line-end* word (sp1 word)* pre-do do-block | "in" line-end* pre-do do-block | do-block
for-arith-rest ::= "((" arith-body "))" pre-do do-block
do-block ::= "do" line-end* list? line-end* "done"
pre-do ::= (sp? list-sep)*
select-command ::= "select" sp1 word line-end* select-rest
select-rest ::= "in" line-end* word (sp1 word)* pre-do do-block | "in" line-end* pre-do do-block | pre-do do-block
case-command ::= "case" sp1 word line-end* "in" line-end* case-clause* sp? "esac"
case-clause ::= line-end* "("? sp? case-patterns sp? ")" line-end* list? case-terminator
case-patterns ::= case-pattern (sp? "|" sp? case-pattern)*
case-pattern ::= word
case-terminator ::= (line-end* sp? (";;" | ";&" | ";;&" | ";")) | line-end+
redirection ::= here-string | heredoc-eof | heredoc-non-eof | io-redir
here-string ::= io-number? "<<<" sp? redir-target
heredoc-eof ::= io-number? heredoc-op sp? eof-marker sp? line-end heredoc-eof-body
heredoc-non-eof ::= io-number? heredoc-op sp? heredoc-marker sp? line-end any-text
heredoc-op ::= "<<" "-"?
eof-marker ::= "EOF" | "'EOF'"
heredoc-marker ::= non-eof-marker | single-quoted | double-quoted | dollar-single-quoted | dollar-double-quoted | param-expansion | command-substitution | process-substitution | backquote
non-eof-marker ::= marker-1 | marker-2 | marker-4-plus | marker-3-not-eof
marker-1 ::= [A-Za-z0-9_.-]
marker-2 ::= [A-Za-z0-9_.-][A-Za-z0-9_.-]
marker-4-plus ::= [A-Za-z0-9_.-][A-Za-z0-9_.-][A-Za-z0-9_.-][A-Za-z0-9_.-]+
marker-3-not-eof ::= marker-3-not-e | marker-e-not-o | marker-eo-not-f
marker-3-not-e ::= [A-DF-Za-z0-9_.-] [A-Za-z0-9_.-] [A-Za-z0-9_.-]
marker-e-not-o ::= "E" [A-NP-Za-z0-9_.-] [A-Za-z0-9_.-]
marker-eo-not-f ::= "EO" [A-EG-Za-eg-z0-9_.-]
heredoc-eof-body ::= (heredoc-line nl)* heredoc-eof-term
heredoc-line ::= [^\n]*
heredoc-eof-term ::= sp? "EOF" sp? nl?
io-redir ::= io-number? io-op sp? redir-target
io-number ::= [0-9]+
io-op ::= ">>" | "<>" | ">|" | "&>>" | "&>" | ">&" | "<&" | ">" | "<"
redir-target ::= word
array-assignment ::= name array-op sp? "(" line-end* array-elements? line-end* ")"
name ::= [A-Za-z_][A-Za-z0-9_]*
array-op ::= "=" | "+="
array-elements ::= array-element (array-sep array-element)*
array-sep ::= sp1 | line-end+
array-element ::= word
word ::= word-part+
word-part ::= single-quoted | double-quoted | dollar-single-quoted | dollar-double-quoted | param-expansion | command-substitution | process-substitution | backquote | escaped-char | bare-chunk
bare-chunk ::= bare-char+
bare-char ::= [A-Za-z0-9_.:/=,@%^+*?~$#!-] | "[" | "]" | "{" | "}"
single-quoted ::= "'" [^']* "'"
double-quoted ::= "\"" double-body "\""
double-body ::= ([^"\\] | double-escape)*
double-escape ::= "\\" ([A-Za-z0-9_.:/=,@%^+*?~$#!-] | " " | "\t" | "\n" | "\r" | "\"" | "\\" | "`" | "$")
dollar-double-quoted ::= "$" double-quoted
dollar-single-quoted ::= "$'" dollar-single-body "'"
dollar-single-body ::= ([^'\\] | dollar-single-escape)*
dollar-single-escape ::= "\\" ([A-Za-z0-9_.:/=,@%^+*?~$#!-] | " " | "\t" | "\n" | "\r" | "'" | "\\")
param-expansion ::= "${" param-body "}"
param-body ::= ([^{}] | "{" param-body "}")*
command-substitution ::= "$(" command-sub-body ")"
command-sub-body ::= ([^()] | "(" command-sub-body ")")*
process-substitution ::= ("<(" | ">(") command-sub-body ")"
backquote ::= "`" backquote-body "`"
backquote-body ::= [^`]*
escaped-char ::= "\\" ([A-Za-z0-9_.:/=,@%^+*?~$#!-] | "[" | "]" | "{" | "}" | " " | "\t" | "\n" | "\r" | "|" | "&" | ";" | "<" | ">" | "(" | ")" | "'" | "\"" | "`" | "\\")
any-text ::= ([^\n]* nl)* [^\n]*